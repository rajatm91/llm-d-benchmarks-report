# Per-environment settings for deploy.sh (and bundle.sh). Copy to envs/<env>.env and load with:
#   set -a; source envs/<env>.env; set +a
# Profiles describe the model; this file describes where it goes.

# Cluster: deploy.sh uses kubectl's current context. Point KUBECONFIG at a file that holds only
# this cluster (e.g. from `gcloud container clusters get-credentials ... ` written to that path).
KUBECONFIG=$HOME/.kube/llm-d-prod

# Namespace and the pre-existing ServiceAccount model-server pods run as
NAMESPACE=llm-d
SERVICE_ACCOUNT=llm-d-modelserver

# Your Artifact Registry and how mirrored images are laid out in it (see lib/images.sh).
# bundle.sh writes dist/images-to-mirror.tsv with this layout; copy the images there yourself.
# Use the SAME two values for bundle.sh and deploy.sh.
IMAGE_REGISTRY=us-docker.pkg.dev/my-project/llm-d
IMAGE_TEMPLATE='{registry}/{path}:{tag}'
#   keep {digest} only if your copy preserves digests (a plain docker pull + push of a multi-arch image does not):
# IMAGE_TEMPLATE='{registry}/{host}/{path}@{digest}'
# Artifact Registry remote (pull-through) repos, one per upstream host. Images from these hosts are
# pulled through them (same path, pinned digest) and are left off the mirror list: nothing to copy.
# Hosts not listed here still need IMAGE_REGISTRY. The profiles use docker.io, ghcr.io, gcr.io, quay.io.
# IMAGE_REMOTES='docker.io=asia-south1-docker.pkg.dev/my-project/docker-io-repo ghcr.io=asia-south1-docker.pkg.dev/my-project/ghcr-repo gcr.io=asia-south1-docker.pkg.dev/my-project/gcr-repo quay.io=asia-south1-docker.pkg.dev/my-project/quay-repo'

# Weights stored by garuda, one folder per model (google/gemma-4-31B-it -> google__gemma_4_31b_it)
MODEL_BUCKET=gs://models_registry

# Node-local weight cache (GKE local SSD) and the image of the fetch-model init container
# MODEL_CACHE_PATH=/mnt/stateful_partition/kube-ephemeral-ssd/llm-d-models
# DOWNLOADER_IMAGE=gcr.io/google.com/cloudsdktool/google-cloud-cli:slim
